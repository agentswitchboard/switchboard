{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"error": {
			"type": "string",
			"const": "invalid_grant"
		},
		"reason": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "notPermitted"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "machineInAnotherOrganization"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "unknownWorkspace"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "requestConflict"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "secondFactorRequired"
						},
						"withinSeconds": {
							"type": "integer",
							"exclusiveMinimum": 0,
							"maximum": 9007199254740991
						}
					},
					"required": ["kind", "withinSeconds"],
					"additionalProperties": false
				}
			]
		}
	},
	"required": ["error"],
	"additionalProperties": false
}
