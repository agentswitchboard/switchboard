{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agent-sign-in-example",
	"main": "dist/index.js",
	"compatibility_date": "2026-08-15",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"services": [
		{ "binding": "CENTRAL", "service": "replace-with-private-central-worker" },
		{ "binding": "CENTRAL_LINK", "service": "replace-with-central-storage-worker" },
	],
	"secrets": { "required": ["TURNSTILE_SECRET_KEY"] },
	"ratelimits": [
		// Replace these example namespace IDs with your deployment's IDs.
		{ "name": "SIGN_IN_ATTEMPTS", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "AUTH_REQUESTS", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "replace-with-sign-in-database",
			"database_id": "00000000-0000-4000-8000-000000000000",
			"migrations_dir": "../sign-in-core/drizzle",
		},
	],
	"vars": {
		// Add turnstile: { kind: "deployed", siteKey: "1x00000000000000000000AA" }
		// to this deployment's JSON. The secret is supplied only by its owner.
		// Also set centralIdentityAudience to the private central deployment's identity audience,
		// centralAdminAudience to its distinct admin audience (person-fleet tokens),
		// centralPublicOrigin to exactly central's CENTRAL_PUBLIC_ORIGIN, adminPageClientId to the
		// admin page client's fixed ID, ownerFleetCliClientId to the fleet CLI client's fixed ID,
		// and organizationStatementLifetimeSeconds to 10368000 (120 days); neither has a default.
		"SIGN_IN_CONFIGURATION": "replace-with-private-deployment-configuration",
		"AUTH_SECRET": "replace-with-worker-secret",
		"GOOGLE_CLIENT_ID": "replace-with-provider-client",
		"GOOGLE_CLIENT_SECRET": "replace-with-worker-secret",
		"GITHUB_CLIENT_ID": "replace-with-provider-client",
		"GITHUB_CLIENT_SECRET": "replace-with-worker-secret",
	},
}
